# Copy this file to .env

# [ SECURITY & CORS ]
# Sets the allowed origins for Cross-Origin Resource Sharing (CORS) | (If dev UI is running on http://localhost:8020)
CORS_ALLOW_ORIGINS=https://app.example.com;http://localhost:5173

# Base64-encoded 32-byte key for stored MQTT credentials and verification codes.
# Run any `generate-encryption-key` script and paste it here.
ENCRYPTION_KEY=

# DO NOT TRACK (universal flag that libraries honor to skip sending usage pings)
DO_NOT_TRACK=true

# [ DATABASE ] => [ PostgreSQL ]
# DATABASE_HOST=host.docker.internal # if inside the docker
DATABASE_HOST=127.0.0.1 # if outside the docker
DATABASE_PORT=5432
DATABASE_NAME=application_db
DATABASE_USER=application_user
DATABASE_PASSWORD=

# [ DOCKER ]
# Port exposed on the host for the web container.
HOST_PORT=8060
DOCKER_IMAGE_NAME=application-server:local
DOCKER_CONTAINER_PREFIX=application-server