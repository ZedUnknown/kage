<ui:FluentWindow 
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" 
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" 
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" 
    x:Class="KAGE_Client.Views.SetupWindow" 
    Title="KAGE Setup" 
    Height="760" 
    Width="1160" 
    MinHeight="640"
    MinWidth="960" 
    FontFamily="/KAGE_Client;component/Assets/Fonts/#Rajdhani" 
    Foreground="#F4F2F0" 
    Background="#101012" 
    WindowStartupLocation="CenterScreen" 
    WindowState="Maximized"
    ExtendsContentIntoTitleBar="True" 
    WindowBackdropType="Mica"
>
    <ui:FluentWindow.Resources>
        <SolidColorBrush x:Key="SetupRed" Color="#F0323E"/>
        <SolidColorBrush x:Key="SetupMuted" Color="#A49C9D"/>
        <SolidColorBrush x:Key="SetupLine" Color="#303033"/>
        <SolidColorBrush x:Key="SetupGreen" Color="#79DFA2"/>
        <!--
            Rajdhani carries human-readable interface copy.
            0Arame Mono is reserved for labels and actions. Inputs use
            Consolas so uppercase and lowercase characters remain distinct.
        -->
        <FontFamily x:Key="RajdhaniFont">/KAGE_Client;component/Assets/Fonts/#Rajdhani</FontFamily>
        <FontFamily x:Key="ArameFont">/KAGE_Client;component/Assets/Fonts/#0Arame-Mono</FontFamily>
        <Style x:Key="TechnicalLabel" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource ArameFont}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{StaticResource SetupMuted}"/>
        </Style>
        <Style x:Key="PageTitle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource RajdhaniFont}"/>
            <Setter Property="FontSize" Value="32"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,12,0,8"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="PageDescription" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource RajdhaniFont}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{StaticResource SetupMuted}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="LineHeight" Value="21"/>
            <Setter Property="Margin" Value="0,0,0,26"/>
        </Style>
        <Style x:Key="StatusMessage" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource RajdhaniFont}"/>
            <Setter Property="Foreground" Value="{StaticResource SetupMuted}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="LineHeight" Value="19"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="AutomationProperties.LiveSetting" Value="Polite"/>
        </Style>
        <Style x:Key="NavigationButtonStyle" TargetType="RadioButton">
            <Setter Property="FontFamily" Value="{StaticResource RajdhaniFont}"/>
            <Setter Property="Foreground" Value="#EAE7E7"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="#242426"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid MinHeight="82">
                            <Border x:Name="NavigationBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="0,0,0,1"/>
                            <Border x:Name="ActiveEdge" Width="2" HorizontalAlignment="Left" Background="Transparent"/>
                            <Grid Margin="12,16,10,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="30"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="StepNumber" Text="{TemplateBinding Tag}" FontFamily="{StaticResource ArameFont}" FontSize="11" Margin="0,2,0,0" Foreground="{StaticResource SetupMuted}"/>
                                <ContentPresenter Grid.Column="1" VerticalAlignment="Top"/>
                                <TextBlock x:Name="StepState" Grid.Column="2" Text="READY" FontFamily="{StaticResource ArameFont}" FontSize="11" Margin="6,3,0,0" Foreground="{StaticResource SetupMuted}"/>
                            </Grid>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="NavigationBorder" Property="Background" Value="#18181A"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="NavigationBorder" Property="Background" Value="#151517"/>
                                <Setter TargetName="NavigationBorder" Property="BorderThickness" Value="1"/>
                                <Setter TargetName="NavigationBorder" Property="BorderBrush" Value="#414044"/>
                                <Setter TargetName="ActiveEdge" Property="Background" Value="{StaticResource SetupRed}"/>
                                <Setter TargetName="StepNumber" Property="Foreground" Value="{StaticResource SetupRed}"/>
                                <Setter TargetName="StepState" Property="Foreground" Value="{StaticResource SetupRed}"/>
                                <Setter TargetName="StepState" Property="Text" Value="ACTIVE"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="NavigationBorder" Property="BorderBrush" Value="#EAE7E7"/>
                                <Setter TargetName="NavigationBorder" Property="BorderThickness" Value="1"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.42"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                                <Setter TargetName="StepState" Property="Text" Value="LOCKED"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SetupInput" TargetType="TextBox">
            <Setter Property="Background" Value="#222224"/>
            <Setter Property="Foreground" Value="#F4F2F0"/>
            <Setter Property="CaretBrush" Value="#F4F2F0"/>
            <Setter Property="SelectionBrush" Value="#96303B"/>
            <Setter Property="BorderBrush" Value="#454246"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="CharacterCasing" Value="Normal"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="MinHeight" Value="44"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="InputBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="InputBorder" Property="BorderBrush" Value="#8F7478"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="InputBorder" Property="BorderBrush" Value="{StaticResource SetupRed}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SetupTokenInput" TargetType="PasswordBox">
            <Setter Property="Background" Value="#222224"/>
            <Setter Property="Foreground" Value="#F4F2F0"/>
            <Setter Property="CaretBrush" Value="#F4F2F0"/>
            <Setter Property="SelectionBrush" Value="#96303B"/>
            <Setter Property="BorderBrush" Value="#454246"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="MinHeight" Value="44"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border x:Name="InputBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="InputBorder" Property="BorderBrush" Value="#8F7478"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="InputBorder" Property="BorderBrush" Value="{StaticResource SetupRed}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SetupCheckBox" TargetType="CheckBox">
            <Setter Property="Foreground" Value="#F4F2F0"/>
            <Setter Property="FontFamily" Value="{StaticResource RajdhaniFont}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="MinHeight" Value="44"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="UseLayoutRounding" Value="True"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="CheckHitArea" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="22"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border x:Name="CheckBorder" Width="22" Height="22" CornerRadius="3" VerticalAlignment="Center" Background="#222224" BorderBrush="#6D6267" BorderThickness="1">
                                    <Path x:Name="CheckMark" Data="M 1,6 L 5,10 L 12,2" Width="12" Height="10" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" Stroke="#FFFFFF" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Visibility="Collapsed"/>
                                </Border>
                                <ContentPresenter Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="CheckBorder" Property="Background" Value="#C82C38"/>
                                <Setter TargetName="CheckBorder" Property="BorderBrush" Value="{StaticResource SetupRed}"/>
                                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CheckHitArea" Property="Background" Value="#252126"/>
                                <Setter TargetName="CheckBorder" Property="BorderBrush" Value="{StaticResource SetupRed}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="CheckHitArea" Property="Background" Value="#301A20"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="CheckHitArea" Property="BorderBrush" Value="{StaticResource SetupRed}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SetupComboBoxItem" TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="#F4F2F0"/>
            <Setter Property="Background" Value="#222224"/>
            <Setter Property="FontFamily" Value="{StaticResource RajdhaniFont}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemBorder" Background="{TemplateBinding Background}" BorderBrush="Transparent" BorderThickness="1" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#301A20"/>
                                <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{StaticResource SetupRed}"/>
                            </Trigger>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#3B252B"/>
                                <Setter TargetName="ItemBorder" Property="BorderBrush" Value="#8F7478"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SetupComboBox" TargetType="ComboBox">
            <Setter Property="Foreground" Value="#F4F2F0"/>
            <Setter Property="Background" Value="#222224"/>
            <Setter Property="BorderBrush" Value="#454246"/>
            <Setter Property="FontFamily" Value="{StaticResource RajdhaniFont}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="MinHeight" Value="44"/>
            <Setter Property="ItemContainerStyle" Value="{StaticResource SetupComboBoxItem}"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="DropdownToggle" Style="{x:Null}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Focusable="False" ClickMode="Press" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1">
                                            <Path Data="M 0,0 L 5,5 L 10,0" Stroke="#A49C9D" StrokeThickness="1.5" Width="10" Height="6" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,14,0"/>
                                        </Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" Margin="12,8,36,8" VerticalAlignment="Center" IsHitTestVisible="False"/>
                            <Popup x:Name="PART_Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False">
                                <Border Background="#222224" BorderBrush="#8F7478" BorderThickness="1" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" MaxHeight="240">
                                    <ScrollViewer CanContentScroll="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="BorderBrush" Value="#8F7478"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter Property="BorderBrush" Value="{StaticResource SetupRed}"/>
                            </Trigger>
                            <Trigger Property="IsDropDownOpen" Value="True">
                                <Setter Property="BorderBrush" Value="{StaticResource SetupRed}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ActionButton" TargetType="ui:Button">
            <Setter Property="Background" Value="#E62B37"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#E62B37"/>
            <Setter Property="FontFamily" Value="{StaticResource ArameFont}"/>
            <Setter Property="FontSize" Value="12"/>
            <!-- <Setter Property="FontWeight" Value=""/> -->
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="MinHeight" Value="44"/>
            <Setter Property="Padding" Value="18,12"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ui:Button">
                        <Grid Background="Transparent">
                            <!-- Chamfered silhouette scales with the control. The full area remains clickable. -->
                            <Canvas IsHitTestVisible="False">
                                <Path x:Name="ButtonShape" Data="M 0,0 L 98,0 100,26 100,100 2,100 0,74 Z" Stretch="Fill" Width="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" Height="{Binding ActualHeight, RelativeSource={RelativeSource TemplatedParent}}" Fill="{TemplateBinding Background}" Stroke="{TemplateBinding BorderBrush}" StrokeThickness="1"/>
                            </Canvas>
                            <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" RecognizesAccessKey="True"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonShape" Property="Opacity" Value="0.8"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonShape" Property="Opacity" Value="0.6"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="ButtonShape" Property="Stroke" Value="White"/>
                                <Setter TargetName="ButtonShape" Property="StrokeThickness" Value="2"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonShape" Property="Fill" Value="#292629"/>
                                <Setter TargetName="ButtonShape" Property="Stroke" Value="#514449"/>
                                <Setter Property="Foreground" Value="#BEB1B5"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="NextButton" TargetType="ui:Button" BasedOn="{StaticResource ActionButton}">
            <Setter Property="Background" Value="Transparent"/>
            <!-- <Setter Property="BorderBrush" Value="#685055"/> -->
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="MinHeight" Value="34"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="Margin" Value="0,16,0,0"/>
        </Style>
        <Style x:Key="ServerAction" TargetType="ui:Button" BasedOn="{StaticResource ActionButton}">
            <Setter Property="Content" Value="CONNECT AND VERIFY CLIENT"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Visibility, ElementName=ServerNextButton}" Value="Visible">
                    <Setter Property="Content" Value="CLIENT VERIFIED / CHECK AGAIN"/>
                    <Setter Property="Background" Value="#173C2B"/>
                    <Setter Property="BorderBrush" Value="#2B6041"/>
                    <Setter Property="Foreground" Value="{StaticResource SetupGreen}"/>
                </DataTrigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Content" Value="CONNECTING..."/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </ui:FluentWindow.Resources>
    <Border Background="#101012" BorderBrush="#39373A" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="48"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Border Background="#0B0B0D" BorderBrush="#2B292C" BorderThickness="0,0,0,1">
                <ui:TitleBar Title="KAGE Setup" ApplicationTheme="Dark" Foreground="#EAE7E7" ButtonsForeground="#A49C9D">
                    <ui:TitleBar.Header>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="KAGE Setup" Foreground="#EAE7E7" FontSize="12"/>
                            <TextBlock Text="CLIENT" Style="{StaticResource TechnicalLabel}" FontSize="11" Margin="18,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ui:TitleBar.Header>
                </ui:TitleBar>
            </Border>
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="280"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border x:Name="NavigationGrid" Background="#0B0B0D" BorderBrush="#29272A" BorderThickness="0,0,1,0">
                    <Grid Margin="22,28,22,20">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <StackPanel Orientation="Horizontal" Margin="4,0,0,0">
                            <Viewbox Width="37" Height="37" Margin="0,0,12,0">
                                <Grid Width="512" Height="512">
                                    <Path Fill="#F4F2F0" Data="M 256.058 0 C 114.679 0 0 114.602 0 256.019 C 0 397.398 114.679 512 256.058 512 C 397.398 512 512.039 397.398 512.039 256.019 C 512.039 114.602 397.398 0 256.058 0 Z M 256.058 477.998 C 133.419 477.998 34.002 378.581 34.002 256.019 C 34.002 133.38 133.419 34.002 256.058 34.002 C 378.62 34.002 478.075 133.38 478.075 256.019 C 478.075 378.581 378.62 477.998 256.058 477.998 Z"/>
                                    <Path Fill="#F4F2F0" Data="M 335.731 196.129 C 312.857 219.004 308.916 253.585 323.83 280.555 L 275.686 328.699 L 275.686 228.547 C 305.284 220.008 326.96 192.768 326.96 160.427 C 326.96 121.248 295.199 89.487 256.019 89.487 C 216.84 89.487 185.079 121.248 185.079 160.427 C 185.079 192.768 206.755 220.008 236.391 228.547 L 236.391 328.699 L 188.247 280.555 C 203.123 253.585 199.182 219.004 176.308 196.129 C 148.604 168.426 103.706 168.426 76.002 196.129 C 48.298 223.833 48.298 268.77 76.002 296.474 C 98.876 319.348 133.458 323.289 160.389 308.375 L 236.391 384.377 L 236.391 455.858 L 275.686 455.858 L 275.686 384.377 L 351.65 308.375 C 378.62 323.289 413.201 319.348 436.075 296.474 C 463.779 268.77 463.779 223.833 436.075 196.129 C 408.371 168.426 363.435 168.426 335.731 196.129 Z"/>
                                </Grid>
                            </Viewbox>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="KAGE" FontSize="25" FontWeight="Bold" FontFamily="{StaticResource ArameFont}"/>
                                <TextBlock Text="WORKSPACE SYSTEMS" Style="{StaticResource TechnicalLabel}" FontSize="11" Margin="0,2,0,0"/>
                            </StackPanel>
                        </StackPanel>
                        <TextBlock Grid.Row="1" Text="SETUP SEQUENCE / 01-02" Style="{StaticResource TechnicalLabel}" FontSize="11" Margin="4,38,0,12"/>
                        <StackPanel Grid.Row="2">
                            <RadioButton x:Name="ServerNavigationButton" GroupName="SetupNavigation" Tag="01" Style="{StaticResource NavigationButtonStyle}" IsChecked="True" Click="ServerNavigationButton_Click">
                                <StackPanel>
                                    <TextBlock Text="Server" FontSize="14" FontWeight="SemiBold"/>
                                    <TextBlock Text="Verify your Client credentials" FontSize="12" LineHeight="16" TextWrapping="Wrap" Foreground="{StaticResource SetupMuted}" Margin="0,5,0,0"/>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="FinishNavigationButton" GroupName="SetupNavigation" Tag="02" Style="{StaticResource NavigationButtonStyle}" IsEnabled="False" Click="FinishNavigationButton_Click">
                                <StackPanel>
                                    <TextBlock Text="Finish" FontSize="14" FontWeight="SemiBold"/>
                                    <TextBlock Text="Confirm your assigned Hub and PC" FontSize="12" LineHeight="16" TextWrapping="Wrap" Foreground="{StaticResource SetupMuted}" Margin="0,5,0,0"/>
                                </StackPanel>
                            </RadioButton>
                        </StackPanel>
                <Border Grid.Row="3" BorderBrush="#29272A" BorderThickness="0,1,0,0" Padding="0,16,0,0" Margin="4,20,0,0">
                    <StackPanel>
                        <TextBlock Text="© 2026 KAGE. All rights reserved." Style="{StaticResource TechnicalLabel}" FontSize="10" Opacity="0.65"/>
                    </StackPanel>
                </Border>
            </Grid>
                </Border>
                <Grid Grid.Column="1">
                    <Rectangle IsHitTestVisible="False">
                        <Rectangle.Fill>
                            <DrawingBrush TileMode="Tile" Viewport="0,0,28,28" ViewportUnits="Absolute">
                                <DrawingBrush.Drawing>
                                    <GeometryDrawing Geometry="M 28,0 L 0,0 0,28">
                                        <GeometryDrawing.Pen>
                                            <Pen Brush="#09FFFFFF" Thickness="0.5"/>
                                        </GeometryDrawing.Pen>
                                    </GeometryDrawing>
                                </DrawingBrush.Drawing>
                            </DrawingBrush>
                        </Rectangle.Fill>
                    </Rectangle>
                    <Rectangle IsHitTestVisible="False">
                        <Rectangle.Fill>
                            <RadialGradientBrush Center="0.92,0.38" GradientOrigin="0.92,0.38" RadiusX="0.7" RadiusY="0.65">
                                <GradientStop Color="#12D92436" Offset="0"/>
                                <GradientStop Color="#00D92436" Offset="1"/>
                            </RadialGradientBrush>
                        </Rectangle.Fill>
                    </Rectangle>
                    <ScrollViewer x:Name="SetupPageScrollViewer" HorizontalScrollBarVisibility="Disabled" Padding="0" CanContentScroll="False">
                        <ScrollViewer.Style>
                            <Style TargetType="ScrollViewer">
                                <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
                            </Style>
                        </ScrollViewer.Style>
                        <Grid Margin="36,36,36,28" MaxWidth="1200">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="20"/>
                                    <ColumnDefinition Width="240"/>
                                </Grid.ColumnDefinitions>
                                <Grid x:Name="PageHost" ClipToBounds="True">
                                    <StackPanel x:Name="ServerPage" VerticalAlignment="Top">
                                        <TextBlock Text="01 / INITIALIZE CONNECTION" Style="{StaticResource TechnicalLabel}" Foreground="{StaticResource SetupRed}"/>
                                        <TextBlock Text="Connect to KAGE" Style="{StaticResource PageTitle}"/>
                                        <TextBlock Text="Use this PC’s Client credentials to connect and retrieve its assigned Hub and PC from KAGE." Style="{StaticResource PageDescription}" />
                                        <Border Background="#251619" BorderBrush="{StaticResource SetupRed}" BorderThickness="1" Padding="16,10" Margin="0,0,0,18" ClipToBounds="True">
                                            <StackPanel>
                                                <TextBlock Text="[ IMPORTANT ]" FontFamily="{StaticResource ArameFont}" Foreground="{StaticResource SetupRed}" FontSize="12"/>
                                                <Canvas x:Name="RegistrationNoticeViewport" Height="28" Margin="0,4,0,0" ClipToBounds="True" Loaded="RegistrationNoticeViewport_Loaded" SizeChanged="RegistrationNoticeViewport_SizeChanged">
                                                    <StackPanel x:Name="RegistrationNoticeTrack" Orientation="Horizontal" Canvas.Top="3">
                                                        <StackPanel.RenderTransform><TranslateTransform/></StackPanel.RenderTransform>
                                                        <StackPanel x:Name="RegistrationNoticeSegment" Orientation="Horizontal">
                                                            <TextBlock x:Name="RegistrationNoticeText" Text="This PC's MQTT username and token must be added under Clients in KAGE Admin before you enter them here." Foreground="#F4F2F0" FontSize="13" TextWrapping="NoWrap" VerticalAlignment="Center"/>
                                                            <Border x:Name="RegistrationNoticeSeparator" Width="1.5" Height="22" Background="{StaticResource SetupRed}" Margin="20,0" VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Canvas>
                                            </StackPanel>
                                        </Border>
                                        <Border Background="#151517" BorderBrush="{StaticResource SetupLine}" BorderThickness="1">
                                            <Grid>
                                                <Border Height="3" Width="68" Background="{StaticResource SetupRed}" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                                                <StackPanel Margin="24,26,24,24">
                                                    <DockPanel Margin="0,0,0,24">
                                                        <ui:SymbolIcon Symbol="Server24" FontSize="19" Margin="0,0,10,0"/>
                                                        <TextBlock Text="MQTT server connection" FontSize="17" FontWeight="SemiBold"/>
                                                    </DockPanel>
                                                    <Grid Margin="0,0,0,8">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="12"/>
                                                            <ColumnDefinition Width="80"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="Auto"/>
                                                        </Grid.RowDefinitions>
                                                        <Label Content="Broker address" Target="{Binding ElementName=ServerAddressBox}" Padding="0" Margin="0,0,0,9" Foreground="#EAE7E7" FontSize="12"/>
                                                        <Label Grid.Column="2" Content="Port" Target="{Binding ElementName=MqttPortBox}" Padding="0" Margin="0,0,0,9" Foreground="#EAE7E7" FontSize="12"/>
                                                        <Grid Grid.Row="1">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="*"/>
                                                            </Grid.ColumnDefinitions>
                                                            <Border Background="#19191B" BorderBrush="#454246" BorderThickness="1,1,0,1" Padding="10,0">
                                                                <TextBlock x:Name="MqttSchemeText" Text="mqtts://" FontFamily="Consolas" FontSize="13" VerticalAlignment="Center" Foreground="{StaticResource SetupMuted}"/>
                                                            </Border>
                                                            <TextBox Grid.Column="1" x:Name="ServerAddressBox" Text="127.0.0.1" Style="{StaticResource SetupInput}" AutomationProperties.Name="MQTT broker hostname or IP address"/>
                                                        </Grid>
                                                        <TextBox Grid.Row="1" Grid.Column="2" x:Name="MqttPortBox" Text="8883" Style="{StaticResource SetupInput}" AutomationProperties.Name="MQTT broker port"/>
                                                    </Grid>
                                                    <TextBlock Text="Enter a hostname or IP address. The prefix is added automatically." Style="{StaticResource StatusMessage}" Margin="0,0,0,6"/>
                                                    <CheckBox x:Name="MqttTlsBox" Style="{StaticResource SetupCheckBox}" Content="Use TLS (MQTTS)" IsChecked="True" Margin="0,0,0,4"/>
                                                    <TextBlock Text="MQTTS requires a TLS-enabled broker listener. Disable TLS for plain MQTT." Style="{StaticResource StatusMessage}" Margin="0,0,0,14"/>
                                                    <StackPanel x:Name="MqttCertificateArea" Margin="0,0,0,14">
                                                        <Label Content="Broker CA certificate" Target="{Binding ElementName=MqttCertificateModeBox}" Padding="0" Margin="0,0,0,9" Foreground="#EAE7E7" FontSize="12"/>
                                                        <ComboBox x:Name="MqttCertificateModeBox" Style="{StaticResource SetupComboBox}" SelectedIndex="0" AutomationProperties.Name="MQTT certificate trust source">
                                                            <ComboBoxItem Content="Windows trusted certificates" Style="{StaticResource SetupComboBoxItem}"/>
                                                            <ComboBoxItem Content="Custom CA certificate (PEM)" Style="{StaticResource SetupComboBoxItem}"/>
                                                        </ComboBox>
                                                        <StackPanel x:Name="MqttCustomCertificatePanel" Visibility="Collapsed" Margin="0,10,0,0">
                                                            <Label Content="CA certificate PEM" Target="{Binding ElementName=MqttCertificateBox}" Padding="0" Margin="0,0,0,9" Foreground="#EAE7E7" FontSize="12"/>
                                                            <TextBox x:Name="MqttCertificateBox" Style="{StaticResource SetupInput}" Height="160" AcceptsReturn="True" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" AutomationProperties.Name="MQTT CA certificate PEM"/>
                                                            <ui:Button x:Name="MqttCertificateBrowseButton" Style="{StaticResource NextButton}" Content="BROWSE CERTIFICATE..." Click="MqttCertificateBrowseButton_Click" Margin="0,8,0,0" HorizontalAlignment="Left"/>
                                                        </StackPanel>
                                                        <TextBlock Text="Use Windows trusted certificates, or paste / browse the broker's custom PEM CA certificate." Style="{StaticResource StatusMessage}" Margin="0,8,0,0"/>
                                                    </StackPanel>
                                                    <Label Content="Client MQTT username" Target="{Binding ElementName=MqttUsernameBox}" Padding="0" Margin="0,0,0,9" Foreground="#EAE7E7" FontSize="12"/>
                                                    <TextBox x:Name="MqttUsernameBox" Style="{StaticResource SetupInput}" Margin="0,0,0,14" AutomationProperties.Name="Client MQTT username"/>
                                                    <Label Content="Client MQTT token" Target="{Binding ElementName=MqttTokenBox}" Padding="0" Margin="0,0,0,9" Foreground="#EAE7E7" FontSize="12"/>
                                                    <PasswordBox x:Name="MqttTokenBox" Style="{StaticResource SetupTokenInput}" Margin="0,0,0,14" AutomationProperties.Name="MQTT token"/>
                                                    <TextBlock Text="Use the username and token confirmed under Clients in KAGE, not the Hub or admin account. Your assigned Hub and PC are retrieved automatically. Credentials are case-sensitive." Style="{StaticResource StatusMessage}" Margin="0,0,0,14"/>
                                                    <ui:Button x:Name="ServerConnectButton" Style="{StaticResource ServerAction}" Appearance="Primary" Click="ServerConnectButton_Click"/>
                                                    <Grid Margin="0,18,0,0">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Ellipse Width="6" Height="6" Fill="{Binding Foreground, ElementName=StatusText}" Margin="4,4,5,0" VerticalAlignment="Top"/>
                                                        <TextBlock Grid.Column="1" x:Name="StatusText" Text="Awaiting connection" Style="{StaticResource StatusMessage}"/>
                                                    </Grid>
                                                    <ui:Button x:Name="ServerNextButton" Content="NEXT / REVIEW →" Style="{StaticResource NextButton}" Visibility="Collapsed" Click="ServerNextButton_Click"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                        <DockPanel Margin="0,16,0,0">
                                            <TextBlock Text="KAGE / SERVER" Style="{StaticResource TechnicalLabel}" FontSize="11" HorizontalAlignment="Right"/>
                                        </DockPanel>
                                    </StackPanel>
                                    <StackPanel x:Name="FinishPage" VerticalAlignment="Top" Visibility="Collapsed">
                                        <TextBlock Text="02 / CONFIRM ASSIGNMENT" Style="{StaticResource TechnicalLabel}" Foreground="{StaticResource SetupRed}"/>
                                        <TextBlock Text="Ready to finish setup" Style="{StaticResource PageTitle}"/>
                                        <TextBlock Text="KAGE verified the Hub and PC assigned to these Client credentials. Review the details and finish setup." Style="{StaticResource PageDescription}"/>
                                        <Border Background="#151517" BorderBrush="{StaticResource SetupLine}" BorderThickness="1">
                                            <Grid>
                                                <Border Height="3" Width="68" Background="{StaticResource SetupRed}" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                                                <StackPanel Margin="24,26,24,24">
                                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,24">
                                                        <ui:SymbolIcon Symbol="CheckmarkCircle24" FontSize="22" Foreground="{StaticResource SetupGreen}" Margin="0,0,10,0"/>
                                                        <TextBlock Text="Configuration ready" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                    <Border Background="#101012" BorderBrush="{StaticResource SetupLine}" BorderThickness="1" Padding="18" Margin="0,0,0,24">
                                                        <StackPanel>
                                                            <Grid Margin="0,0,0,14">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="100"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Text="SERVER" Style="{StaticResource TechnicalLabel}" FontSize="11" VerticalAlignment="Center"/>
                                                                <TextBlock x:Name="FinishServerText" Grid.Column="1" Text="-" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap"/>
                                                            </Grid>
                                                            <Border Height="1" Background="{StaticResource SetupLine}" Margin="0,0,0,14"/>
                                                            <Grid Margin="0,0,0,14">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="100"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Text="HUB ID" Style="{StaticResource TechnicalLabel}" FontSize="11" VerticalAlignment="Center"/>
                                                                <TextBlock x:Name="FinishHubText" Grid.Column="1" Text="-" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap"/>
                                                            </Grid>
                                                            <Border Height="1" Background="{StaticResource SetupLine}" Margin="0,0,0,14"/>
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="100"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Text="PC ID" Style="{StaticResource TechnicalLabel}" FontSize="11" VerticalAlignment="Center"/>
                                                                <TextBlock x:Name="FinishPcText" Grid.Column="1" Text="-" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap"/>
                                                            </Grid>
                                                        </StackPanel>
                                                    </Border>
                                                    <TextBlock Text="This computer will be linked to the Hub shown above." Foreground="{StaticResource SetupMuted}" FontSize="13" TextWrapping="Wrap" LineHeight="21" Margin="0,0,0,20"/>
                                                    <ui:Button x:Name="RegisterPcButton" Content="FINISH SETUP" Appearance="Primary" Style="{StaticResource ActionButton}" Click="RegisterPcButton_Click"/>
                                                    <TextBlock x:Name="FinishStatusText" Visibility="Collapsed" Margin="0,18,0,0" Style="{StaticResource StatusMessage}"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </StackPanel>
                                </Grid>
                                <ScrollViewer x:Name="SessionStatusScrollViewer" Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                    <StackPanel VerticalAlignment="Top">
                                        <Border Background="#0C0C0E" BorderBrush="{StaticResource SetupLine}" BorderThickness="1" VerticalAlignment="Top">
                                            <StackPanel>
                                                <Border BorderBrush="{StaticResource SetupLine}" BorderThickness="0,0,0,1" Padding="14,12">
                                                    <TextBlock Text="SESSION STATUS" Style="{StaticResource TechnicalLabel}" FontSize="11"/>
                                                </Border>
                                                <StackPanel Margin="14,18,14,18">
                                                    <TextBlock Text="CURRENT STEP" Style="{StaticResource TechnicalLabel}" FontSize="11" Foreground="{StaticResource SetupRed}" Margin="0,0,0,14"/>
                                                    <TextBlock FontSize="12" LineHeight="19" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock" BasedOn="{StaticResource StatusMessage}">
                                                                <Setter Property="Text" Value="{Binding Text, ElementName=StatusText}"/>
                                                                <Setter Property="Foreground" Value="{Binding Foreground, ElementName=StatusText}"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Visibility, ElementName=FinishPage}" Value="Visible">
                                                                        <Setter Property="Text" Value="Assignment verified. Ready to finish setup."/>
                                                                        <Setter Property="Foreground" Value="{StaticResource SetupMuted}"/>
                                                                    </DataTrigger>
                                                                    <MultiDataTrigger>
                                                                        <MultiDataTrigger.Conditions>
                                                                            <Condition Binding="{Binding Visibility, ElementName=FinishPage}" Value="Visible"/>
                                                                            <Condition Binding="{Binding Visibility, ElementName=FinishStatusText}" Value="Visible"/>
                                                                        </MultiDataTrigger.Conditions>
                                                                        <Setter Property="Text" Value="{Binding Text, ElementName=FinishStatusText}"/>
                                                                        <Setter Property="Foreground" Value="{Binding Foreground, ElementName=FinishStatusText}"/>
                                                                    </MultiDataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                    <Border BorderBrush="#29272A" BorderThickness="0,1,0,0" Margin="0,22,0,0" Padding="0,18,0,0">
                                                        <StackPanel>
                                                            <Grid Margin="0,0,0,14">
                                                                <TextBlock Text="Server" FontSize="12" Foreground="#C5BFC1"/>
                                                                <TextBlock HorizontalAlignment="Right">
                                                                    <TextBlock.Style>
                                                                        <Style TargetType="TextBlock" BasedOn="{StaticResource TechnicalLabel}">
                                                                            <Setter Property="Text" Value="PENDING"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding Visibility, ElementName=ServerNextButton}" Value="Visible">
                                                                                    <Setter Property="Text" Value="VERIFIED"/>
                                                                                    <Setter Property="Foreground" Value="{StaticResource SetupGreen}"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBlock.Style>
                                                                </TextBlock>
                                                            </Grid>
                                                            <Grid Margin="0,0,0,14">
                                                                <TextBlock Text="Hub" FontSize="12" Foreground="#C5BFC1"/>
                                                                <TextBlock HorizontalAlignment="Right">
                                                                    <TextBlock.Style>
                                                                        <Style TargetType="TextBlock" BasedOn="{StaticResource TechnicalLabel}">
                                                                            <Setter Property="Text" Value="PENDING"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding Visibility, ElementName=ServerNextButton}" Value="Visible">
                                                                                    <Setter Property="Text" Value="VERIFIED"/>
                                                                                    <Setter Property="Foreground" Value="{StaticResource SetupGreen}"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBlock.Style>
                                                                </TextBlock>
                                                            </Grid>
                                                            <Grid Margin="0,0,0,14">
                                                                <TextBlock Text="PC" FontSize="12" Foreground="#C5BFC1"/>
                                                                <TextBlock HorizontalAlignment="Right">
                                                                    <TextBlock.Style>
                                                                        <Style TargetType="TextBlock" BasedOn="{StaticResource TechnicalLabel}">
                                                                            <Setter Property="Text" Value="PENDING"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding Visibility, ElementName=ServerNextButton}" Value="Visible">
                                                                                    <Setter Property="Text" Value="VERIFIED"/>
                                                                                    <Setter Property="Foreground" Value="{StaticResource SetupGreen}"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBlock.Style>
                                                                </TextBlock>
                                                            </Grid>
                                                        </StackPanel>
                                                    </Border>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                        <StackPanel x:Name="SessionDetailsPanel" Margin="0,12,0,0">
                                            <Border Background="#0D0D0F" BorderBrush="#303033" BorderThickness="1" Margin="0,0,0,8">
                                                <Grid>
                                                    <Border Width="3" Background="{StaticResource SetupRed}" HorizontalAlignment="Left"/>
                                                    <StackPanel Margin="12,11">
                                                        <TextBlock Text="OPERATION" Style="{StaticResource TechnicalLabel}" FontSize="11" Margin="0,0,0,9"/>
                                                        <TextBlock FontSize="11" Foreground="#EAE7E7" TextTrimming="CharacterEllipsis">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock" BasedOn="{StaticResource TechnicalLabel}">
                                                                    <Setter Property="Text" Value="MQTT CONNECTION"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Visibility, ElementName=FinishPage}" Value="Visible">
                                                                            <Setter Property="Text" Value="DEVICE REGISTRATION"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                            <Border Background="#0D0D0F" BorderBrush="#303033" BorderThickness="1" Margin="0,0,0,8">
                                                <Grid>
                                                    <StackPanel Margin="12,11">
                                                        <TextBlock Text="PROTOCOL" Style="{StaticResource TechnicalLabel}" FontSize="11" Margin="0,0,0,9"/>
                                                        <TextBlock Text="MQTT / JSON" FontFamily="{StaticResource ArameFont}" FontSize="11"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                            <Border Background="#0D0D0F" BorderBrush="#303033" BorderThickness="1" Margin="0,0,0,8">
                                                <Grid>
                                                    <StackPanel Margin="12,11">
                                                        <TextBlock Text="SERVER" Style="{StaticResource TechnicalLabel}" FontSize="11" Margin="0,0,0,9"/>
                                                        <TextBlock FontSize="11" Foreground="#EAE7E7" TextTrimming="CharacterEllipsis">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock" BasedOn="{StaticResource TechnicalLabel}">
                                                                    <Setter Property="Text" Value="AWAITING CHECK"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsEnabled, ElementName=ServerConnectButton}" Value="False">
                                                                            <Setter Property="Text" Value="CONNECTING..."/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding Visibility, ElementName=ServerNextButton}" Value="Visible">
                                                                            <Setter Property="Text" Value="CLIENT VERIFIED"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                            <Border Background="#0D0D0F" BorderBrush="#303033" BorderThickness="1" Margin="0">
                                                <Grid>
                                                    <StackPanel Margin="12,11">
                                                        <TextBlock Text="STEP" Style="{StaticResource TechnicalLabel}" FontSize="11" Margin="0,0,0,9"/>
                                                        <TextBlock FontSize="11" Foreground="#EAE7E7">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock" BasedOn="{StaticResource TechnicalLabel}">
                                                                    <Setter Property="Text" Value="01 / 02"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Visibility, ElementName=FinishPage}" Value="Visible">
                                                                            <Setter Property="Text" Value="02 / 02"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </StackPanel>
                                    </StackPanel>
                                </ScrollViewer>
                            </Grid>
                        </Grid>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</ui:FluentWindow>
