# Copy to .env.docker and pass it with: docker compose --env-file .env.docker ...
# Use the public HTTPS address served by your reverse proxy.
ORIGIN=https://kage.example.com
KAGE_PORT=8060

# Keep these values stable after first deployment. Back up the database and key.
DATABASE_NAME=kage
DATABASE_USER=kage
DATABASE_PASSWORD=
KAGE_ENCRYPTION_KEY=
