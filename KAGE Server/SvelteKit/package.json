{
	"name": "kage-server",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "concurrently --kill-others --names web,mqtt -P \"vite dev {@}\" \"npm run worker:dev\" --",
		"build": "vite build",
		"start": "node --env-file=.env scripts/start.mjs",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"db:migrate": "node scripts/migrate.ts",
		"worker": "node scripts/mqtt-worker.ts",
		"worker:dev": "node --watch scripts/mqtt-worker.ts",
		"test": "node --test --test-concurrency=1 tests/*.test.ts",
		"test:routes": "vite build && node --test tests/routes.test.ts",
		"check:worker": "tsc --ignoreConfig --noEmit --allowImportingTsExtensions --module nodenext --target es2023 --strict --skipLibCheck scripts/mqtt-worker.ts scripts/migrate.ts"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@sveltejs/adapter-node": "^6.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@tailwindcss/vite": "^4.3.0",
		"@types/node": "^24",
		"@types/pg": "^8.23.1",
		"concurrently": "^10.0.7",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.19.0",
		"globals": "^17.6.0",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"prettier-plugin-tailwindcss": "^0.8.0",
		"svelte": "^5.57.1",
		"svelte-check": "^4.6.0",
		"tailwindcss": "^4.3.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.60.1",
		"vite": "^8.3.0"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"dependencies": {
		"mqtt": "^5.16.0",
		"pg": "^8.23.1",
		"svelte-sonner": "^1.2.3",
		"uplot": "^1.6.32"
	}
}
