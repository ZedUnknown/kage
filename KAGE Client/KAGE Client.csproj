<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RootNamespace>KAGE_Client</RootNamespace>
    <AssemblyName>KAGE_Client</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
  </PropertyGroup>

  <ItemGroup>
    <!-- Keep WinForms tray support from introducing ambiguous WPF type names. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove=".verification\**" />
    <Page Remove=".verification\**" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="Assets\Images\**" />
    <EmbeddedResource Remove="Assets\Images\**" />
    <None Remove="Assets\Images\**" />
    <Page Remove="Assets\Images\**" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="Assets\Fonts\arame-mono-regular.ttf" />
    <None Remove="Assets\Fonts\arame-mono-Bold.ttf" />
    <None Remove="Assets\Fonts\Rajdhani-Bold.ttf" />
    <None Remove="Assets\Fonts\Rajdhani-Light.ttf" />
    <None Remove="Assets\Fonts\Rajdhani-Medium.ttf" />
    <None Remove="Assets\Fonts\Rajdhani-Regular.ttf" />
    <None Remove="Assets\Fonts\Rajdhani-SemiBold.ttf" />
    <None Remove="Assets\Icons\kage.ico" />
    <None Remove="Certificates\ca.crt" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\Icons\kage.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Certificates\ca.crt" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MQTTnet" Version="5.2.0.1603" />
    <PackageReference Include="WPF-UI" Version="4.3.0" />
  </ItemGroup>

  <!-- Optional Mosquitto CA. Omit ca.crt to use normal Windows certificate trust. -->
  <ItemGroup Condition="Exists('ca.crt')">
    <EmbeddedResource Include="ca.crt" LogicalName="KAGE_Client.ca.crt" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\Fonts\arame-mono-regular.ttf">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </Resource>
    <Resource Include="Assets\Fonts\arame-mono-Bold.ttf">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </Resource>
    <Resource Include="Assets\Fonts\Rajdhani-Bold.ttf">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </Resource>
    <Resource Include="Assets\Fonts\Rajdhani-Light.ttf">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </Resource>
    <Resource Include="Assets\Fonts\Rajdhani-Medium.ttf">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </Resource>
    <Resource Include="Assets\Fonts\Rajdhani-Regular.ttf">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </Resource>
    <Resource Include="Assets\Fonts\Rajdhani-SemiBold.ttf">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </Resource>
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Apis\" />
  </ItemGroup>

</Project>
