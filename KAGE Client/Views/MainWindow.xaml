<ui:FluentWindow x:Class="KAGE_Client.Views.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:views="clr-namespace:KAGE_Client.Views"
                 Title="KAGE Client" Height="760" Width="1160"
                 MinHeight="640" MinWidth="960"
                 FontFamily="/KAGE_Client;component/Assets/Fonts/#Rajdhani"
                 Foreground="#F4F2F0" Background="#101012"
                 WindowStartupLocation="CenterScreen"
                 ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica">
    <ui:FluentWindow.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/KAGE_Client;component/Styles/KageTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="Panel" TargetType="Border">
                <Setter Property="Background" Value="#151517"/>
                <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding" Value="18"/>
            </Style>
            <Style x:Key="StatusDot" TargetType="Ellipse">
                <Setter Property="Width" Value="6"/>
                <Setter Property="Height" Value="6"/>
                <Setter Property="Margin" Value="0,0,8,0"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="Fill" Value="{StaticResource MutedBrush}"/>
            </Style>
            <Style x:Key="DeviceValue" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource RajdhaniFont}"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="Margin" Value="0,6,0,0"/>
                <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            </Style>
            <Style x:Key="RefreshAction" TargetType="ui:Button" BasedOn="{StaticResource ActionButton}">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ui:Button">
                            <Grid Background="Transparent">
                                <!-- Fixed-size corner cuts stay even as the button resizes. -->
                                <Canvas IsHitTestVisible="False">
                                    <views:ChamferedButtonShape x:Name="ButtonShape" Width="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" Height="{Binding ActualHeight, RelativeSource={RelativeSource TemplatedParent}}" Fill="{TemplateBinding Background}" Stroke="{TemplateBinding BorderBrush}" StrokeThickness="1"/>
                                </Canvas>
                                <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" RecognizesAccessKey="True"/>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="ButtonShape" Property="Opacity" Value="0.8"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="ButtonShape" Property="Opacity" Value="0.6"/>
                                </Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="ButtonShape" Property="Stroke" Value="White"/>
                                    <Setter TargetName="ButtonShape" Property="StrokeThickness" Value="2"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="ButtonShape" Property="Fill" Value="#292629"/>
                                    <Setter TargetName="ButtonShape" Property="Stroke" Value="#514449"/>
                                    <Setter Property="Foreground" Value="#BEB1B5"/>
                                    <Setter Property="Cursor" Value="Arrow"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Setter Property="Content" Value="REFRESH STATE"/>
                <Setter Property="MinHeight" Value="38"/>
                <Setter Property="Padding" Value="14,10"/>
                <Setter Property="FontSize" Value="11"/>
                <Style.Triggers>
                    <Trigger Property="IsEnabled" Value="False">
                        <Setter Property="Content" Value="LOADING STATE..."/>
                    </Trigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </ui:FluentWindow.Resources>
    <Border Background="#101012" BorderBrush="#39373A" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="48"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Border Background="#0B0B0D" BorderBrush="#2B292C" BorderThickness="0,0,0,1">
                <ui:TitleBar Title="KAGE Client" ApplicationTheme="Dark" Foreground="#EAE7E7" ButtonsForeground="#A49C9D">
                    <ui:TitleBar.Header>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="KAGE Client" Foreground="#EAE7E7" FontSize="12"/>
                            <TextBlock Text="WORKSPACE" Style="{StaticResource TechnicalLabel}" Margin="18,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ui:TitleBar.Header>
                </ui:TitleBar>
            </Border>
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="280"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Background="#0B0B0D" BorderBrush="#29272A" BorderThickness="0,0,1,0">
                    <Grid Margin="22,28,22,20">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <StackPanel Orientation="Horizontal" Margin="4,0,0,0">
                            <Viewbox Width="37" Height="37" Margin="0,0,12,0">
                                <Grid Width="512" Height="512">
                                    <Path Fill="#F4F2F0" Data="M 256.058 0 C 114.679 0 0 114.602 0 256.019 C 0 397.398 114.679 512 256.058 512 C 397.398 512 512.039 397.398 512.039 256.019 C 512.039 114.602 397.398 0 256.058 0 Z M 256.058 477.998 C 133.419 477.998 34.002 378.581 34.002 256.019 C 34.002 133.38 133.419 34.002 256.058 34.002 C 378.62 34.002 478.075 133.38 478.075 256.019 C 478.075 378.581 378.62 477.998 256.058 477.998 Z"/>
                                    <Path Fill="#F4F2F0" Data="M 335.731 196.129 C 312.857 219.004 308.916 253.585 323.83 280.555 L 275.686 328.699 L 275.686 228.547 C 305.284 220.008 326.96 192.768 326.96 160.427 C 326.96 121.248 295.199 89.487 256.019 89.487 C 216.84 89.487 185.079 121.248 185.079 160.427 C 185.079 192.768 206.755 220.008 236.391 228.547 L 236.391 328.699 L 188.247 280.555 C 203.123 253.585 199.182 219.004 176.308 196.129 C 148.604 168.426 103.706 168.426 76.002 196.129 C 48.298 223.833 48.298 268.77 76.002 296.474 C 98.876 319.348 133.458 323.289 160.389 308.375 L 236.391 384.377 L 236.391 455.858 L 275.686 455.858 L 275.686 384.377 L 351.65 308.375 C 378.62 323.289 413.201 319.348 436.075 296.474 C 463.779 268.77 463.779 223.833 436.075 196.129 C 408.371 168.426 363.435 168.426 335.731 196.129 Z"/>
                                </Grid>
                            </Viewbox>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="KAGE" FontSize="28" FontWeight="Bold"/>
                                <TextBlock Text="WORKSPACE SYSTEMS" Style="{StaticResource TechnicalLabel}" Margin="0,2,0,0"/>
                            </StackPanel>
                        </StackPanel>
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,34,0,16">
                            <StackPanel>
                                <TextBlock Text="OVERVIEW" Style="{StaticResource TechnicalLabel}" Margin="4,0,0,12"/>
                                <Border Background="#151517" BorderBrush="#414044" BorderThickness="1">
                                    <Grid>
                                        <Border Width="2" Background="{StaticResource RedBrush}" HorizontalAlignment="Left"/>
                                        <Grid Margin="12,16">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                            <ui:SymbolIcon Symbol="Desktop24" FontSize="17" Foreground="{StaticResource RedBrush}" VerticalAlignment="Top" Margin="0,2,10,0"/>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="Workspace overview" FontSize="15" FontWeight="SemiBold"/>
                                                <TextBlock Text="Connectivity and assignments" FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="0,5,0,0"/>
                                            </StackPanel>
                                        </Grid>
                                    </Grid>
                                </Border>
                                <TextBlock Text="SYSTEM ASSIGNMENT" Style="{StaticResource TechnicalLabel}" Margin="4,28,0,4"/>
                                <Border BorderBrush="#242426" BorderThickness="0,0,0,1" Padding="12,16">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="01" Style="{StaticResource TechnicalLabel}" Margin="0,2,0,0"/>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="Server" FontSize="12" Foreground="{StaticResource MutedBrush}"/>
                                            <TextBlock Text="{Binding ServerAddress}" Style="{StaticResource DeviceValue}" ToolTip="{Binding ServerAddress}" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <Border BorderBrush="#242426" BorderThickness="0,0,0,1" Padding="12,16">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="02" Style="{StaticResource TechnicalLabel}" Margin="0,2,0,0"/>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="Hub ID" FontSize="12" Foreground="{StaticResource MutedBrush}"/>
                                            <TextBlock Text="{Binding HubId}" Style="{StaticResource DeviceValue}" ToolTip="{Binding HubId}"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <Border BorderBrush="#242426" BorderThickness="0,0,0,1" Padding="12,16">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="03" Style="{StaticResource TechnicalLabel}" Margin="0,2,0,0"/>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="PC ID" FontSize="12" Foreground="{StaticResource MutedBrush}"/>
                                            <TextBlock Text="{Binding PcId}" Style="{StaticResource DeviceValue}" ToolTip="{Binding PcId}"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <Border BorderBrush="#242426" BorderThickness="0,0,0,1" Padding="12,16">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="04" Style="{StaticResource TechnicalLabel}" Margin="0,2,0,0"/>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="Chair ID" FontSize="12" Foreground="{StaticResource MutedBrush}"/>
                                            <TextBlock Text="{Binding ChairId}" Style="{StaticResource DeviceValue}" ToolTip="{Binding ChairId}"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                        <Border Grid.Row="2" BorderBrush="#29272A" BorderThickness="0,1,0,0" Padding="0,16,0,0" Margin="4,0,0,0">
                            <StackPanel>
                                <TextBlock Text="© 2026 KAGE. All rights reserved." Style="{StaticResource TechnicalLabel}" FontSize="10" Opacity="0.65"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>
                <Grid Grid.Column="1">
                    <Rectangle IsHitTestVisible="False">
                        <Rectangle.Fill>
                            <DrawingBrush TileMode="Tile" Viewport="0,0,28,28" ViewportUnits="Absolute">
                                <DrawingBrush.Drawing>
                                    <GeometryDrawing Geometry="M 28,0 L 0,0 0,28">
                                        <GeometryDrawing.Pen><Pen Brush="#09FFFFFF" Thickness="0.5"/></GeometryDrawing.Pen>
                                    </GeometryDrawing>
                                </DrawingBrush.Drawing>
                            </DrawingBrush>
                        </Rectangle.Fill>
                    </Rectangle>
                    <Rectangle IsHitTestVisible="False">
                        <Rectangle.Fill>
                            <RadialGradientBrush Center="0.92,0.38" GradientOrigin="0.92,0.38" RadiusX="0.7" RadiusY="0.65">
                                <GradientStop Color="#12D92436" Offset="0"/>
                                <GradientStop Color="#00D92436" Offset="1"/>
                            </RadialGradientBrush>
                        </Rectangle.Fill>
                    </Rectangle>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" CanContentScroll="False">
                        <StackPanel Margin="36,28,36,24" MaxWidth="1200">
                            <Grid Margin="0,0,0,22">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="1.2*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="0.85*"/></Grid.ColumnDefinitions>
                                <Border Background="#0D0D0F" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Margin="0,0,8,0">
                                    <Grid>
                                        <Border Width="3" Background="{StaticResource RedBrush}" HorizontalAlignment="Left"/>
                                        <StackPanel Margin="12,11">
                                            <TextBlock Text="MODE" Style="{StaticResource TechnicalLabel}" Margin="0,0,0,9"/>
                                            <TextBlock Text="WORKSPACE MONITORING" Style="{StaticResource TechnicalLabel}" Foreground="#EAE7E7" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <Border Grid.Column="1" Background="#0D0D0F" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Margin="0,0,8,0" Padding="12,11">
                                    <StackPanel>
                                        <TextBlock Text="SERVER" Style="{StaticResource TechnicalLabel}" Margin="0,0,0,9"/>
                                        <TextBlock Text="{Binding ServerStatus}" Foreground="{Binding ServerColor}" Style="{StaticResource TechnicalLabel}" TextTrimming="CharacterEllipsis" ToolTip="{Binding ServerMessage}"/>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="2" Background="#0D0D0F" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Padding="12,11">
                                    <StackPanel>
                                        <TextBlock Text="STATE SOURCE" Style="{StaticResource TechnicalLabel}" Margin="0,0,0,9"/>
                                        <TextBlock Text="{Binding RequestType}" Style="{StaticResource TechnicalLabel}" Foreground="#EAE7E7"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                            <TextBlock Text="WORKSPACE STATUS" FontSize="32" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,10,0,4"/>
                            <TextBlock Text="Monitor server connectivity, Hub assignment, and endpoint status." FontSize="13" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,0,18"/>
                            <Border Style="{StaticResource Panel}" Padding="0" Margin="0,0,0,18">
                                <Grid>
                                    <Border Height="3" Width="68" Background="{StaticResource RedBrush}" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                                    <Grid Margin="22,20">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="96"/></Grid.ColumnDefinitions>
                                        <StackPanel AutomationProperties.LiveSetting="Polite" VerticalAlignment="Center" Margin="0,0,20,0">
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                                <Ellipse Style="{StaticResource StatusDot}" Fill="{Binding MonitoringColor}"/>
                                                <TextBlock Text="{Binding MonitoringLabel}" Style="{StaticResource TechnicalLabel}" Foreground="{Binding MonitoringColor}" TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <TextBlock Text="{Binding MonitoringTitle}" FontSize="25" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding MonitoringDescription}" FontSize="13" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                                        </StackPanel>
                                        <Grid Grid.Column="1" Width="90" Height="90" VerticalAlignment="Center" IsHitTestVisible="False">
                                            <Path Data="M 12,0 L 78,0 90,12 90,78 78,90 12,90 0,78 0,12 Z" Fill="#1E171B" Stroke="#4D3038" StrokeThickness="1"/>
                                            <ui:SymbolIcon Symbol="Shield24" FontSize="38" Foreground="#C68890"/>
                                            <Border Background="{Binding MonitoringColor}" Width="5" Height="5" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,14,14"/>
                                        </Grid>
                                    </Grid>
                                </Grid>
                            </Border>
                            <Grid Margin="0,0,0,18">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="0.9*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="1.1*"/></Grid.ColumnDefinitions>
                                <Border Style="{StaticResource Panel}">
                                    <Grid>
                                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                        <DockPanel>
                                            <ui:SymbolIcon Symbol="Pulse24" FontSize="18" Foreground="{StaticResource MutedBrush}" Margin="0,0,10,0"/>
                                            <TextBlock Text="Seat presence" FontSize="17" FontWeight="SemiBold"/>
                                        </DockPanel>
                                        <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="0,20,0,20">
                                            <TextBlock Text="{Binding SeatStatus}" FontSize="28" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding SeatDescription}" Foreground="{StaticResource MutedBrush}" FontSize="13" Margin="0,6,0,0" TextWrapping="Wrap"/>
                                        </StackPanel>
                                        <Border Grid.Row="2" BorderThickness="0,1,0,0" BorderBrush="{StaticResource LineBrush}" Padding="0,13,0,0">
                                            <TextBlock Text="{Binding ChairLabel}" FontSize="12" Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis" ToolTip="{Binding ChairLabel}"/>
                                        </Border>
                                    </Grid>
                                </Border>
                                <Border Grid.Column="2" Style="{StaticResource Panel}">
                                    <StackPanel>
                                        <DockPanel Margin="0,0,0,16">
                                            <ui:SymbolIcon Symbol="Link24" FontSize="18" Foreground="{StaticResource MutedBrush}" Margin="0,0,10,0"/>
                                            <TextBlock Text="Connections" FontSize="17" FontWeight="SemiBold"/>
                                        </DockPanel>
                                        <Grid Margin="0,0,0,8" AutomationProperties.LiveSetting="Polite">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <TextBlock Text="Server" FontSize="14" Margin="0,0,8,0"/>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                <Ellipse Fill="{Binding ServerColor}" Style="{StaticResource StatusDot}" Margin="4,5,5,0" VerticalAlignment="Top"/>
                                                <TextBlock Text="{Binding ServerStatus}" Foreground="{Binding ServerColor}" ToolTip="{Binding ServerMessage}" FontSize="13"/>
                                            </StackPanel>
                                        </Grid>
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <TextBlock Text="Hub" FontSize="14" Margin="0,0,8,0"/>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                <Ellipse Fill="{Binding HubColor}" Style="{StaticResource StatusDot}" Margin="4,5,5,0" VerticalAlignment="Top"/>
                                                <TextBlock Text="{Binding HubStatus}" Foreground="{Binding HubColor}" FontSize="13"/>
                                            </StackPanel>
                                        </Grid>
                                        <Grid Margin="0,0,0,16">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <TextBlock Text="Sensor" FontSize="14" Margin="0,0,8,0"/>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                <Ellipse Fill="{Binding SensorColor}" Style="{StaticResource StatusDot}" Margin="4,5,5,0" VerticalAlignment="Top"/>
                                                <TextBlock Text="{Binding SensorStatus}" Foreground="{Binding SensorColor}" FontSize="13"/>
                                            </StackPanel>
                                        </Grid>
                                        <ui:Button IsEnabled="{Binding CanRefresh}" Style="{StaticResource RefreshAction}" Click="RefreshButton_Click" ToolTip="Request the latest client state." AutomationProperties.Name="Refresh client state"/>
                                        <TextBlock Text="{Binding LastChecked}" FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,9,0,0" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                            <Border Background="#0D0D0F" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Padding="14,12">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="LAST EVENT" Style="{StaticResource TechnicalLabel}" VerticalAlignment="Center" Margin="0,0,14,0"/>
                                    <TextBlock Grid.Column="1" Text="{Binding LastEvent}" ToolTip="{Binding LastEvent}" FontSize="13" Foreground="#EAE7E7" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite"/>
                                    <TextBlock Grid.Column="2" Text="{Binding LastEventTime}" Style="{StaticResource TechnicalLabel}" Margin="12,0,0,0" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</ui:FluentWindow>

