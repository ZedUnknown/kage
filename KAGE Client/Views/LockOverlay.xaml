<ui:FluentWindow x:Class="KAGE_Client.Views.LockOverlay"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="KAGELOCK / Security action"
                 WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False"
                 Topmost="False" WindowStartupLocation="Manual"
                 ExtendsContentIntoTitleBar="True" Background="Transparent"
                 Foreground="#F4F2F0" FontFamily="/KAGE_Client;component/Assets/Fonts/#Rajdhani">
    <ui:FluentWindow.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/KAGE_Client;component/Styles/KageTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="DurationItem" TargetType="ComboBoxItem">
                <Setter Property="Foreground" Value="#F4F2F0"/>
                <Setter Property="Background" Value="#151517"/>
                <Setter Property="Padding" Value="14,10"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ComboBoxItem">
                            <Border x:Name="ItemBorder" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                <ContentPresenter ContentTemplate="{TemplateBinding ContentTemplate}"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsHighlighted" Value="True">
                                    <Setter TargetName="ItemBorder" Property="Background" Value="#423034"/>
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource RedBrush}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="DurationSelector" TargetType="ComboBox">
                <Setter Property="Foreground" Value="#F4F2F0"/>
                <Setter Property="FontFamily" Value="Consolas"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="ItemContainerStyle" Value="{StaticResource DurationItem}"/>
                <Setter Property="ItemTemplate">
                    <Setter.Value><DataTemplate><TextBlock Text="{Binding StringFormat={}{0} min}"/></DataTemplate></Setter.Value>
                </Setter>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ComboBox">
                            <Grid>
                                <ToggleButton Style="{x:Null}" Focusable="False" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                              IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border x:Name="SelectorBorder" Background="#151517" BorderBrush="#514449" BorderThickness="1">
                                                <TextBlock Text="⌄" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0" Foreground="#F4F2F0"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="SelectorBorder" Property="BorderBrush" Value="{StaticResource RedBrush}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                </ToggleButton>
                                <ContentPresenter Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" Margin="14,0,34,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
                                <Border x:Name="FocusBorder" BorderBrush="#F4F2F0" BorderThickness="1" Visibility="Collapsed" IsHitTestVisible="False"/>
                                <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False">
                                    <Border Background="#151517" BorderBrush="#514449" BorderThickness="1" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                                        <ScrollViewer><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/></ScrollViewer>
                                    </Border>
                                </Popup>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                    <Setter TargetName="FocusBorder" Property="Visibility" Value="Visible"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="OverlaySectionLabel" TargetType="TextBlock" BasedOn="{StaticResource TechnicalLabel}">
                <Setter Property="FontSize" Value="10"/>
                <Setter Property="Foreground" Value="#A88992"/>
            </Style>
            <DrawingBrush x:Key="OverlayDotGrid" TileMode="Tile" Viewport="0,0,20,20" ViewportUnits="Absolute">
                <DrawingBrush.Drawing>
                    <DrawingGroup>
                        <GeometryDrawing Brush="Transparent" Geometry="M 0,0 L 20,0 20,20 0,20 Z"/>
                        <GeometryDrawing Brush="#26434B51">
                            <GeometryDrawing.Geometry><EllipseGeometry Center="10,10" RadiusX="0.7" RadiusY="0.7"/></GeometryDrawing.Geometry>
                        </GeometryDrawing>
                    </DrawingGroup>
                </DrawingBrush.Drawing>
            </DrawingBrush>
            <DrawingBrush x:Key="OverlayHatch" TileMode="Tile" Viewport="0,0,40,40" ViewportUnits="Absolute"
                          Viewbox="0,0,40,40" ViewboxUnits="Absolute">
                <DrawingBrush.Drawing>
                    <DrawingGroup>
                        <GeometryDrawing Brush="Transparent" Geometry="M 0,0 L 40,0 40,40 0,40 Z"/>
                        <GeometryDrawing Brush="#D65564" Geometry="M 4,28 L 28,4 33,4 9,28 Z"/>
                        <GeometryDrawing Geometry="M 12,34 L 34,12">
                            <GeometryDrawing.Pen><Pen Brush="#96616A" Thickness="1"/></GeometryDrawing.Pen>
                        </GeometryDrawing>
                        <GeometryDrawing Brush="#9B7078" Geometry="M 4,4 L 7,4 7,7 4,7 Z"/>
                    </DrawingGroup>
                </DrawingBrush.Drawing>
            </DrawingBrush>
            <DrawingBrush x:Key="OverlayTicks" TileMode="Tile" Viewport="0,0,12,8" ViewportUnits="Absolute">
                <DrawingBrush.Drawing>
                    <DrawingGroup>
                        <GeometryDrawing Brush="Transparent" Geometry="M 0,0 L 12,0 12,8 0,8 Z"/>
                        <GeometryDrawing Geometry="M 1,0 L 1,8">
                            <GeometryDrawing.Pen><Pen Brush="#AA666D" Thickness="1"/></GeometryDrawing.Pen>
                        </GeometryDrawing>
                    </DrawingGroup>
                </DrawingBrush.Drawing>
            </DrawingBrush>

        </ResourceDictionary>
    </ui:FluentWindow.Resources>
    <Grid ClipToBounds="True">
        <Image x:Name="DesktopSnapshot" Stretch="Fill" IsHitTestVisible="False">
            <Image.Effect><BlurEffect Radius="18"/></Image.Effect>
        </Image>
        <!-- Acrylic is drawn by Windows behind this tint, never over the warning text. -->
        <Border Background="#66060608"/>
        <!-- Decorative only. Toggle showMonitorFrame in LockOverlay.xaml.cs. -->
        <Grid x:Name="MonitorFrame" Margin="14" Visibility="{Binding MonitorFrameVisibility}"
              IsHitTestVisible="False" Focusable="False">
            <Path Data="M 0,18 L 18,0 982,0 1000,18 1000,582 982,600 18,600 0,582 Z"
                  Stretch="Fill" Stroke="#A7733E49" StrokeThickness="1"/>
            <Border Margin="8,8" BorderBrush="#286AA7AD" BorderThickness="1"/>

            <Grid Width="112" Height="70" HorizontalAlignment="Left" VerticalAlignment="Top">
                <Path Data="M 0,60 L 0,18 18,0 112,0 102,5 21,5 5,21 5,54 Z" Fill="{StaticResource RedBrush}"/>
                <Path Data="M 12,62 L 12,26 26,12 76,12" Stroke="#8FCCD0" StrokeThickness="1"/>
                <Path Data="M 30,19 L 40,19 M 44,19 L 50,19 M 54,19 L 60,19" Stroke="{StaticResource AccentBrush}" StrokeThickness="2"/>
            </Grid>
            <Grid Width="112" Height="70" HorizontalAlignment="Right" VerticalAlignment="Top" RenderTransformOrigin="0.5,0.5">
                <Grid.RenderTransform><ScaleTransform ScaleX="-1"/></Grid.RenderTransform>
                <Path Data="M 0,60 L 0,18 18,0 112,0 102,5 21,5 5,21 5,54 Z" Fill="{StaticResource RedBrush}"/>
                <Path Data="M 12,62 L 12,26 26,12 76,12" Stroke="#8FCCD0" StrokeThickness="1"/>
                <Path Data="M 30,19 L 40,19 M 44,19 L 50,19 M 54,19 L 60,19" Stroke="{StaticResource AccentBrush}" StrokeThickness="2"/>
            </Grid>
            <Grid Width="112" Height="70" HorizontalAlignment="Left" VerticalAlignment="Bottom" RenderTransformOrigin="0.5,0.5">
                <Grid.RenderTransform><ScaleTransform ScaleY="-1"/></Grid.RenderTransform>
                <Path Data="M 0,60 L 0,18 18,0 112,0 102,5 21,5 5,21 5,54 Z" Fill="{StaticResource RedBrush}"/>
                <Path Data="M 12,62 L 12,26 26,12 76,12" Stroke="#8FCCD0" StrokeThickness="1"/>
            </Grid>
            <Grid Width="112" Height="70" HorizontalAlignment="Right" VerticalAlignment="Bottom" RenderTransformOrigin="0.5,0.5">
                <Grid.RenderTransform><ScaleTransform ScaleX="-1" ScaleY="-1"/></Grid.RenderTransform>
                <Path Data="M 0,60 L 0,18 18,0 112,0 102,5 21,5 5,21 5,54 Z" Fill="{StaticResource RedBrush}"/>
                <Path Data="M 12,62 L 12,26 26,12 76,12" Stroke="#8FCCD0" StrokeThickness="1"/>
            </Grid>

            <Grid Width="350" Height="50" HorizontalAlignment="Center" VerticalAlignment="Top">
                <Path Data="M 0,0 L 350,0 333,50 17,50 Z" Fill="#EF111116" Stroke="#87404B" StrokeThickness="1"/>

                <Viewbox Width="34" Height="34" Margin="0,0,12,0">
                    <Grid Width="512" Height="512">
                        <Path Fill="{StaticResource RedBrush}" Data="M 256.058 0 C 114.679 0 0 114.602 0 256.019 C 0 397.398 114.679 512 256.058 512 C 397.398 512 512.039 397.398 512.039 256.019 C 512.039 114.602 397.398 0 256.058 0 Z M 256.058 477.998 C 133.419 477.998 34.002 378.581 34.002 256.019 C 34.002 133.38 133.419 34.002 256.058 34.002 C 378.62 34.002 478.075 133.38 478.075 256.019 C 478.075 378.581 378.62 477.998 256.058 477.998 Z"/>
                        <Path Fill="{StaticResource RedBrush}" Data="M 335.731 196.129 C 312.857 219.004 308.916 253.585 323.83 280.555 L 275.686 328.699 L 275.686 228.547 C 305.284 220.008 326.96 192.768 326.96 160.427 C 326.96 121.248 295.199 89.487 256.019 89.487 C 216.84 89.487 185.079 121.248 185.079 160.427 C 185.079 192.768 206.755 220.008 236.391 228.547 L 236.391 328.699 L 188.247 280.555 C 203.123 253.585 199.182 219.004 176.308 196.129 C 148.604 168.426 103.706 168.426 76.002 196.129 C 48.298 223.833 48.298 268.77 76.002 296.474 C 98.876 319.348 133.458 323.289 160.389 308.375 L 236.391 384.377 L 236.391 455.858 L 275.686 455.858 L 275.686 384.377 L 351.65 308.375 C 378.62 323.289 413.201 319.348 436.075 296.474 C 463.779 268.77 463.779 223.833 436.075 196.129 C 408.371 168.426 363.435 168.426 335.731 196.129 Z"/>
                    </Grid>
                </Viewbox>
            </Grid>
            <Border Width="200" Height="4" Background="{StaticResource RedBrush}" HorizontalAlignment="Center" VerticalAlignment="Bottom"/>
        </Grid>
        <Border x:Name="WarningBand" VerticalAlignment="Center" Background="#F70C0D10"
                BorderBrush="#75343A" BorderThickness="0,1">
            <Grid>
                <!-- Quiet technical texture; the desktop remains visible outside the band. -->
                <Rectangle Fill="{StaticResource OverlayDotGrid}" IsHitTestVisible="False" Opacity="0.65"/>
                <Rectangle Width="112" HorizontalAlignment="Left" Fill="{StaticResource OverlayHatch}" Opacity="0.13" IsHitTestVisible="False">
                    <Rectangle.OpacityMask>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0"><GradientStop Color="White" Offset="0"/><GradientStop Color="Transparent" Offset="1"/></LinearGradientBrush>
                    </Rectangle.OpacityMask>
                </Rectangle>
                <Rectangle Width="112" HorizontalAlignment="Right" Fill="{StaticResource OverlayHatch}" Opacity="0.13" IsHitTestVisible="False">
                    <Rectangle.OpacityMask>
                        <LinearGradientBrush StartPoint="1,0" EndPoint="0,0"><GradientStop Color="White" Offset="0"/><GradientStop Color="Transparent" Offset="1"/></LinearGradientBrush>
                    </Rectangle.OpacityMask>
                </Rectangle>
                <Path Data="M 0,0 L 106,0 94,5 0,5 Z" Fill="{StaticResource RedBrush}" Stretch="Fill"
                      Width="150" Height="5" HorizontalAlignment="Left" VerticalAlignment="Top" IsHitTestVisible="False"/>
                <Path Data="M 0,0 L 8,0 8,68 3,74 3,108 0,108 Z" Fill="{StaticResource RedBrush}"
                      Width="8" Height="108" Stretch="Fill" HorizontalAlignment="Left" VerticalAlignment="Center" IsHitTestVisible="False"/>
                <Path Data="M 8,0 L 0,0 0,68 5,74 5,108 8,108 Z" Fill="{StaticResource RedBrush}"
                      Width="8" Height="108" Stretch="Fill" HorizontalAlignment="Right" VerticalAlignment="Center" IsHitTestVisible="False"/>

                <Grid Margin="40,0" MaxWidth="1480">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Identity and policy stay separate from the command message. -->
                    <Grid Margin="0,22,0,18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- <Viewbox Width="34" Height="34" Margin="0,0,12,0">
                                <Grid Width="512" Height="512">
                                    <Path Fill="#F4F2F0" Data="M 256.058 0 C 114.679 0 0 114.602 0 256.019 C 0 397.398 114.679 512 256.058 512 C 397.398 512 512.039 397.398 512.039 256.019 C 512.039 114.602 397.398 0 256.058 0 Z M 256.058 477.998 C 133.419 477.998 34.002 378.581 34.002 256.019 C 34.002 133.38 133.419 34.002 256.058 34.002 C 378.62 34.002 478.075 133.38 478.075 256.019 C 478.075 378.581 378.62 477.998 256.058 477.998 Z"/>
                                    <Path Fill="#F4F2F0" Data="M 335.731 196.129 C 312.857 219.004 308.916 253.585 323.83 280.555 L 275.686 328.699 L 275.686 228.547 C 305.284 220.008 326.96 192.768 326.96 160.427 C 326.96 121.248 295.199 89.487 256.019 89.487 C 216.84 89.487 185.079 121.248 185.079 160.427 C 185.079 192.768 206.755 220.008 236.391 228.547 L 236.391 328.699 L 188.247 280.555 C 203.123 253.585 199.182 219.004 176.308 196.129 C 148.604 168.426 103.706 168.426 76.002 196.129 C 48.298 223.833 48.298 268.77 76.002 296.474 C 98.876 319.348 133.458 323.289 160.389 308.375 L 236.391 384.377 L 236.391 455.858 L 275.686 455.858 L 275.686 384.377 L 351.65 308.375 C 378.62 323.289 413.201 319.348 436.075 296.474 C 463.779 268.77 463.779 223.833 436.075 196.129 C 408.371 168.426 363.435 168.426 335.731 196.129 Z"/>
                                </Grid>
                            </Viewbox> -->
                            <!-- <TextBlock Text="KAGELOCK" FontFamily="{StaticResource ArameFont}" FontSize="24" Foreground="#F4F2F0" VerticalAlignment="Center"/> -->
                            <TextBlock Text="{Binding ActionTitle}" FontSize="36" FontWeight="Bold" TextWrapping="Wrap" LineHeight="36" Foreground="#FAF6F5"/>
                            <Border Width="1" Height="18" Background="#454047" Margin="20,0"/>
                            <TextBlock Text="WORKSTATION SECURITY" FontSize="16" Style="{StaticResource TechnicalLabel}" Foreground="#B7AFB2" VerticalAlignment="Center"/>
                        </StackPanel>
                        <Border Grid.Column="1" Background="#281318" BorderBrush="#71323B" BorderThickness="1" Padding="12,9" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <Rectangle Width="5" Height="5" Fill="{StaticResource RedBrush}" Margin="0,0,9,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding ModeLabel}" Style="{StaticResource TechnicalLabel}" FontSize="10" Foreground="#FF8790"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Grid Grid.Row="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="1"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid>
                            <Border Background="#323037"/>
                            <Border Width="80" Background="{StaticResource RedBrush}" HorizontalAlignment="Left"/>
                            <Border Width="32" Background="{StaticResource RedBrush}" HorizontalAlignment="Right"/>
                        </Grid>
                        <Grid Grid.Row="1" Margin="0,24,0,24">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="400"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Action and message -->
                            <Grid Margin="0,0,28,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <!-- <TextBlock Text="01 / SECURITY ACTION" Style="{StaticResource OverlaySectionLabel}"/> -->
                                <StackPanel Grid.Row="1" VerticalAlignment="Top" Margin="0,12,0,0">
                                    <!-- <TextBlock Text="{Binding ActionTitle}" FontSize="36" FontWeight="Bold" TextWrapping="Wrap" LineHeight="36" Foreground="#FAF6F5"/> -->
                                    <TextBlock Text="{Binding PolicyDescription}" FontSize="20" Foreground="{StaticResource AccentBrush}" Margin="0,8,0,20" TextWrapping="Wrap"/>
                                    <Border BorderBrush="{StaticResource RedBrush}" BorderThickness="2,0,0,0" Padding="12,0,0,0">
                                        <StackPanel>
                                            <TextBlock Text="MESSAGE" Style="{StaticResource TechnicalLabel}" FontSize="11" Foreground="#857E85" Margin="0,0,0,7"/>
                                            <ScrollViewer MaxHeight="65" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                                <TextBlock Text="{Binding CommandMessage}" FontSize="17" Foreground="#DCD5D6" TextWrapping="Wrap" LineHeight="21"/>
                                            </ScrollViewer>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Grid>

                            <!-- Countdown instrument -->
                            <Grid Grid.Column="1" MinHeight="228">
                                <Path Data="M 0,0 L 94,0 100,9 100,100 6,100 0,91 Z" Stretch="Fill"
                                      Fill="#F3121116" Stroke="#573037" StrokeThickness="1" IsHitTestVisible="False"/>
                                <Path Data="M 0,26 L 0,0 26,0" Stroke="{StaticResource RedBrush}" StrokeThickness="2"
                                      Width="26" Height="26" HorizontalAlignment="Left" VerticalAlignment="Top" IsHitTestVisible="False"/>
                                <Path Data="M 0,26 L 26,26 26,0" Stroke="{StaticResource RedBrush}" StrokeThickness="2"
                                      Width="26" Height="26" HorizontalAlignment="Right" VerticalAlignment="Bottom" IsHitTestVisible="False"/>
                                <Grid Margin="32,28">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <DockPanel>
                                        <!-- <TextBlock Text="02" Style="{StaticResource TechnicalLabel}" Foreground="#706168" DockPanel.Dock="Left"/> -->
                                        <TextBlock Text="{Binding CountdownLabel}" FontSize="10" Style="{StaticResource TechnicalLabel}" Foreground="#9E888F" HorizontalAlignment="Center"/>
                                    </DockPanel>
                                    <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="0,12,0,10">
                                        <Viewbox Stretch="Uniform" StretchDirection="DownOnly" Height="106">
                                            <TextBlock Text="{Binding CountdownText}" FontFamily="Consolas" FontSize="104" FontWeight="Bold"
                                                       AutomationProperties.Name="Time remaining">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="#FFF4F2"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsUrgent}" Value="True">
                                                                <Setter Property="Foreground" Value="{StaticResource RedBrush}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Viewbox>
                                        <TextBlock Text="UNTIL ACTION" FontSize="10" Style="{StaticResource TechnicalLabel}" Foreground="#9E888F" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                    <Grid Grid.Row="2" Margin="0,6,0,0" ClipToBounds="True">
                                        <!-- Scale marks are decorative, not a second countdown. -->
                                        <Rectangle Fill="{StaticResource OverlayTicks}" Height="8" VerticalAlignment="Bottom" Opacity="0.6" Margin="0,0,-12,0">
                                            <Rectangle.RenderTransform>
                                                <TranslateTransform/>
                                            </Rectangle.RenderTransform>
                                            <Rectangle.Triggers>
                                                <EventTrigger RoutedEvent="Loaded">
                                                    <BeginStoryboard x:Name="MovingTicks">
                                                        <Storyboard RepeatBehavior="Forever">
                                                            <!-- One tile per cycle gives a seamless horizontal scroll. -->
                                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                                             From="0" To="-12" Duration="0:0:1.2"/>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </EventTrigger>
                                                <EventTrigger RoutedEvent="Unloaded">
                                                    <RemoveStoryboard BeginStoryboardName="MovingTicks"/>
                                                </EventTrigger>
                                            </Rectangle.Triggers>
                                        </Rectangle>
                                        <Rectangle Width="3" Height="12" Fill="{StaticResource RedBrush}" HorizontalAlignment="Center" VerticalAlignment="Bottom"/>
                                    </Grid>
                                </Grid>
                            </Grid>

                            <!-- Response controls -->
                            <Grid Grid.Column="2" Margin="28,0,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <!-- <TextBlock Text="03 / RESPONSE" Style="{StaticResource OverlaySectionLabel}"/> -->
                                <StackPanel Grid.Row="1" VerticalAlignment="Top" HorizontalAlignment="Left" MaxWidth="330" Margin="0,12,0,0">
                                    <TextBlock Text="Request more time" FontSize="28" FontWeight="SemiBold" Margin="0,0,0,12"/>
                                    <TextBlock Text="EXTENSION DURATION" Style="{StaticResource TechnicalLabel}" FontSize="11" Foreground="#91868D" Margin="0,0,0,9"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="102"/>
                                            <ColumnDefinition Width="24"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <ComboBox x:Name="DurationBox" Style="{StaticResource DurationSelector}" Height="46"
                                                  ItemsSource="{Binding ExtensionDurations}" SelectedItem="{Binding SelectedDuration}" IsEnabled="{Binding CanExtend}"
                                                  AutomationProperties.Name="Extension duration in minutes"/>
                                        <ui:Button Grid.Column="2" Content="EXTEND" Style="{StaticResource ActionButton}" IsEnabled="{Binding CanExtend}"
                                                   Click="ExtendButton_Click" Height="46" Padding="12,10"/>
                                    </Grid>
                                    <ui:Button Content="CANCEL EXTENSION" Style="{StaticResource ActionButton}" Background="#181517" BorderBrush="#655059"
                                               Visibility="{Binding CancelVisibility}" IsEnabled="{Binding CanCancel}" Click="CancelButton_Click"
                                               HorizontalAlignment="Stretch" MinHeight="34" Padding="12,8" FontSize="10" Margin="0,10,0,0"
                                               AutomationProperties.Name="Cancel extended countdown"/>
                                    <TextBlock Text="{Binding ControlHint}" Foreground="{StaticResource MutedBrush}" FontSize="14" TextWrapping="Wrap" Margin="0,12,0,0" LineHeight="18"/>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Grid>

                    <!-- Status strip and the separate development escape hatch -->
                    <Border Grid.Row="2" BorderBrush="#323037" BorderThickness="0,1,0,0" Padding="0,12,0,14">
                        <Grid MinHeight="32">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,24,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="//" Foreground="{StaticResource RedBrush}" FontFamily="Consolas" FontWeight="Bold" FontSize="16" Margin="0,0,12,2"/>
                                    <TextBlock Grid.Column="1" Text="{Binding FeedbackMessage}" FontSize="14" TextWrapping="Wrap"
                                               AutomationProperties.LiveSetting="Polite" VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{StaticResource WaitingBrush}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding FeedbackMessage}" Value="Security monitoring remains active during this countdown.">
                                                        <Setter Property="Foreground" Value="#CDBDC1"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                                <TextBlock Text="{Binding KeyboardInputWarning}" Visibility="{Binding KeyboardWarningVisibility}"
                                           Foreground="{StaticResource WaitingBrush}" FontSize="14" TextWrapping="Wrap" Margin="28,4,0,0"
                                           AutomationProperties.LiveSetting="Assertive"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Visibility="{Binding SafetyButtonVisibility}">
                                <TextBlock Text="DEV /" Style="{StaticResource TechnicalLabel}" FontSize="9" Foreground="#9B896C" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <ui:Button Content="SAFETY STOP" Style="{StaticResource ActionButton}" Background="#191619"
                                           BorderBrush="#796347" Foreground="{StaticResource WaitingBrush}" Click="SafetyButton_Click"
                                           MinHeight="30" Padding="12,7" FontSize="10" AutomationProperties.Name="Safety stop countdown"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</ui:FluentWindow>

