# Postgres (Neon pooled connection string works on Vercel)
DATABASE_URL=postgres://user:pass@host/db

# Shared secret the broker webhook / simulator sends as x-ingest-key
INGEST_KEY=change-me

# Admin portal login and cookie signing
ADMIN_PASSWORD=change-me
SESSION_SECRET=at-least-32-random-characters-long-string

# MQTT broker used to publish commands to PCs (mqtts://host:8883)
MQTT_URL=mqtts://broker.example.com:8883
MQTT_USERNAME=
MQTT_PASSWORD=

# Topic namespace: kage/{SITE_ID}/...
SITE_ID=lab1
